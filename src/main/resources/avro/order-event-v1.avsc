{"doc":"Order event schema v1 — the original contract. Kept on the classpath so the simulator can produce genuine v1 records for the evolution demo.","fields":[{"name":"orderId","type":"string"},{"name":"customerId","type":"string"},{"name":"amountCents","type":"long"},{"default":"USD","name":"currency","type":"string"},{"name":"itemCount","type":"int"},{"name":"producedAt","type":"long"},{"default":"v1","name":"schemaVersion","type":"string"}],"name":"OrderEvent","namespace":"dev.vishalbhardwaj.eventpulse.avro","type":"record"}